# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling scratch
/.playwright/
/.playwright-cli/

# design reference copies (kept locally)
/design-refs/

waitlist-*.csv

# voice word exports (fan-typed words, keep private) and the offline model venv
/voice-words*.csv
/indicxlit-review*.csv
/.venv-indicxlit/

# helper apps keep their own dependencies
/tools/*/node_modules

# helper app settings hold a helper token and a Discord webhook address
/tools/*/config.json

# keys and credentials of any kind
*.key
*.p12
*.pfx
*.keystore
service-account*.json
client_secret*.json
credentials*.json

# Screenshots of today's tip pages for the page builder gate (local only; see test/gate)
/test-baseline/

# full-quality clips the OBS helper saves
/tools/*/clips
